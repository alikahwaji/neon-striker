// Firestore Security Rules for Neon Striker
//
// Threat model: the Firebase Web SDK config in database.js is bundled into
// the public site (this is by-design — Firebase Web apps can't hide it).
// Any visitor can extract the projectId from DevTools and call the
// Firestore REST API directly. These rules are the ONLY thing standing
// between the project quota / leaderboard integrity and an attacker with
// the public config.
//
// Posture:
//   * Reads on leaderboard collections: OPEN (the leaderboard UI needs them).
//   * Creates: STRICT — exact shape, types, and ranges validated server-side.
//     Mirrors the writes in database.js (saveGlobalHighScore /
//     saveDailyHighScore). Any extra field or oversized/illegal value is
//     rejected by Firestore before the document is written.
//   * Updates & deletes: BLOCKED. Scores are append-only. Nobody — not even
//     the original poster — can edit or remove a row once it lands.
//   * All other paths/collections: DENY-BY-DEFAULT.
//
// To deploy: paste into Firebase Console → Firestore → Rules → Publish.
// (Or `firebase deploy --only firestore:rules` if you install the CLI.)

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function isValidName(v) {
      return v is string
          && v.size() > 0
          && v.size() <= 18;
    }

    function isValidScore(v) {
      // Cap at 100,000,000 — well above any legitimate score (the in-game
      // hybrid formatter handles up to 7-digit values comfortably).
      // Rejects negatives, decimals, strings, NaN, and silly outliers.
      return v is int
          && v >= 0
          && v <= 100000000;
    }

    function isValidDate(v) {
      // YYYY-MM-DD, 10 chars exactly. Matches todayDateUTC() output in
      // config.js.
      return v is string
          && v.size() == 10
          && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function hasOnlyFields(data, allowed) {
      return data.keys().hasOnly(allowed)
          && data.keys().hasAll(allowed);
    }

    // ---------- Global all-time leaderboard ----------
    // Document shape (from database.js saveGlobalHighScore):
    //   { name: string ≤18, score: int, timestamp: serverTimestamp() }
    match /leaderboard/{docId} {
      allow read: if true;

      allow create: if
        hasOnlyFields(request.resource.data, ['name', 'score', 'timestamp'])
        && isValidName(request.resource.data.name)
        && isValidScore(request.resource.data.score)
        && request.resource.data.timestamp == request.time;

      allow update, delete: if false;
    }

    // ---------- Daily challenge leaderboard ----------
    // Document shape (from database.js saveDailyHighScore):
    //   { name, score, date: 'YYYY-MM-DD', timestamp: serverTimestamp() }
    // The date field must equal today's UTC date — prevents back-filling
    // yesterday's or future dates' boards.
    match /leaderboard_daily/{docId} {
      allow read: if true;

      allow create: if
        hasOnlyFields(request.resource.data, ['name', 'score', 'date', 'timestamp'])
        && isValidName(request.resource.data.name)
        && isValidScore(request.resource.data.score)
        && isValidDate(request.resource.data.date)
        && request.resource.data.date == request.time.date().toString()
        && request.resource.data.timestamp == request.time;

      allow update, delete: if false;
    }

    // ---------- Default deny ----------
    // Any path not matched above is denied. Required because the wildcard
    // match in `rules_version = '2'` does NOT implicitly deny outside the
    // collections above — be explicit.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
